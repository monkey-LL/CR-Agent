{
  "$defs": {
    "Confidence": {
      "description": "How confident the reviewer is in this finding.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Severity": {
      "description": "Finding severity levels, ordered by impact.",
      "enum": [
        "blocker",
        "major",
        "minor",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "description": "A single code review finding.",
  "properties": {
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File"
    },
    "line": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Line"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "suggestion": {
      "title": "Suggestion",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "medium"
    },
    "source": {
      "default": "deterministic",
      "enum": [
        "deterministic",
        "llm"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "severity",
    "message",
    "suggestion"
  ],
  "title": "Finding",
  "type": "object"
}