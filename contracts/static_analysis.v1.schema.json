{
  "description": "单次静态分析工具（lint、type-check）的运行结果。",
  "properties": {
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "status": {
      "default": "skipped",
      "enum": [
        "pass",
        "fail",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "issues": {
      "default": 0,
      "title": "Issues",
      "type": "integer"
    },
    "output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    }
  },
  "required": [
    "tool"
  ],
  "title": "StaticAnalysisResult",
  "type": "object"
}